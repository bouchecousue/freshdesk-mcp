NODE_ENV=development
HOST=127.0.0.1
PORT=8788
PUBLIC_URL=http://127.0.0.1:8788
DATABASE_PATH=./var/freshdesk-mcp.sqlite3

# Generate with: npm run generate-master-key
FRESHDESK_MCP_MASTER_KEY=

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
AUTH_REQUEST_TTL_SECONDS=600
WRITE_INTENT_TTL_SECONDS=600
CIMD_ALLOWED_HOST_SUFFIXES=chatgpt.com,openai.com

# Optional semantic search: local embedding server only (see docs/en/semantic-search.md).
FRESHDESK_EMBEDDING_URL=http://127.0.0.1:9932/v1/embeddings
